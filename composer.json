{
    "name": "frappant/frp-form-answers",
    "type": "typo3-cms-extension",
    "description": "Adds the possibility, as a finisher, to save and export the form entries from customers.",
    "homepage": "https://frappant.ch",
    "require": {
        "typo3/cms-core": "^13.1",
        "typo3/cms-form": "^13.1",
        "phpoffice/phpspreadsheet": "^5.2.0"
    },
    "license": "GPL-2.0+",
    "autoload": {
        "psr-4": {
            "Frappant\\FrpFormAnswers\\": "Classes"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "vendor-dir": ".Build/vendor"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0.x-dev"
        },
        "typo3/cms": {
            "app-dir": ".Build",
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "extension-key": "frp_form_answers",
            "web-dir": ".Build/web"
        }
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.44",
        "phpstan/phpstan": "^2.1.25",
        "phpunit/phpunit": "^11.2.5",
        "typo3/coding-standards": "^0.8",
        "typo3/testing-framework": "^9.0.1"
    }
}